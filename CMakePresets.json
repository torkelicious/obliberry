{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-base-2026",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ninja-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-profile",
      "displayName": "Linux (Profiler Build)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_UNITY_BUILD": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELWITHDEBINFO": "OFF"
      }
    },
    {
      "name": "linux-sanitizers",
      "displayName": "Linux Debug + ASan/UBSan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON",
        "ENABLE_UNITY_BUILD": "OFF"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-sanitizers",
      "displayName": "macOS Debug + ASan/UBSan",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON",
        "ENABLE_UNITY_BUILD": "OFF"
      }
    },
    {
      "name": "windows-default",
      "displayName": "Windows (VS22)",
      "inherits": "windows-base"
    },
    {
      "name": "windows-default-2026",
      "displayName": "Windows (VS26)",
      "inherits": "windows-base-2026"
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows Release (Ninja/cl, for CI)",
      "inherits": "windows-ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows Debug (Ninja/cl, for CI)",
      "inherits": "windows-ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-profile",
      "displayName": "Linux Perf Profile",
      "configurePreset": "linux-profile"
    },
    {
      "name": "linux-sanitizers",
      "displayName": "Linux ASan/UBSan",
      "configurePreset": "linux-sanitizers"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "macos-sanitizers",
      "displayName": "macOS ASan/UBSan",
      "configurePreset": "macos-sanitizers"
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (VS22)",
      "configurePreset": "windows-default",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (VS22)",
      "configurePreset": "windows-default",
      "configuration": "Release"
    },
    {
      "name": "windows-debug-2026",
      "displayName": "Windows Debug (VS26)",
      "configurePreset": "windows-default-2026",
      "configuration": "Debug"
    },
    {
      "name": "windows-release-2026",
      "displayName": "Windows Release (VS26)",
      "configurePreset": "windows-default-2026",
      "configuration": "Release"
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows Release (Ninja/cl)",
      "configurePreset": "windows-ninja-release"
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows Debug (Ninja/cl)",
      "configurePreset": "windows-ninja-debug"
    }
  ]
}
