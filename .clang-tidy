# Obliberry clang-tidy config.
#
---
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  modernize-*,
  cppcoreguidelines-slicing,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-special-member-functions,
  readability-braces-around-statements,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-else-after-return,
  readability-implicit-bool-conversion,
  readability-non-const-parameter,
  readability-redundant-*,
  readability-simplify-*,
  readability-static-*,
  readability-avoid-return-with-void-value,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-reserved-identifier,
  -bugprone-narrowing-conversions,
  -modernize-avoid-c-arrays,
  -modernize-concat-nested-namespaces,
  -modernize-use-nodiscard,
  -performance-avoid-endl,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix,
  -readability-function-cognitive-complexity

WarningsAsErrors: 'bugprone-use-after-move,bugprone-dangling-handle,clang-analyzer-*'

HeaderFilterRegex: '(src|include)/.*'
ExcludeHeaderFilterRegex: '(third_party/|external/|_deps/|build/|vendor/)'

FormatStyle: file

CheckOptions:
  # pointer conditions keep allowed
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: true
  # flags/bitmask style code (rendering, input, ECS, ImGui)
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: true

  # member-init: don't rage on math types, vertex structs etc
  - key: cppcoreguidelines-pro-type-member-init.IgnoreArrays
    value: true
ExtraArgs:
  - '-std=gnu++20'
