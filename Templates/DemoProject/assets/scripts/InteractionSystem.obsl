//
// This file shows how to implement Camera Movement in ObSL
//

var ZOOM_SPEED = 0.2;
var PAN_SPEED = 15.0;
var EDGE_MARGIN = 20.0;

fn on_update(dt) {

    if (Input_IsKeyDown("Esc")) {
        CloseWindow();
    }

    var scroll_y = Input_GetScrollY();
    if (scroll_y != 0.0) {
        var current_zoom = Camera_GetZoom();
        current_zoom = current_zoom + (scroll_y * ZOOM_SPEED);

        if (current_zoom < 0.5) { current_zoom = 0.5; }
        if (current_zoom > 5.0) { current_zoom = 5.0; }

        Camera_SetZoom(current_zoom);
    }

    var pan_x = 0.0;
    var pan_y = 0.0;

    if (Input_IsKeyDown("W")) { pan_y = pan_y + 1.0; }
    if (Input_IsKeyDown("S")) { pan_y = pan_y - 1.0; }
    if (Input_IsKeyDown("A")) { pan_x = pan_x - 1.0; }
    if (Input_IsKeyDown("D")) { pan_x = pan_x + 1.0; }

    var window_w = Window_GetWidth();
    var window_h = Window_GetHeight();
    var mouse_x = Input_GetMouseX();
    var mouse_y = Input_GetMouseY();

    if (mouse_x <= EDGE_MARGIN)            { pan_x = pan_x - 1.0; }
    if (mouse_x >= window_w - EDGE_MARGIN) { pan_x = pan_x + 1.0; }
    if (mouse_y <= EDGE_MARGIN)            { pan_y = pan_y + 1.0; }
    if (mouse_y >= window_h - EDGE_MARGIN) { pan_y = pan_y - 1.0; }

    if (pan_x != 0.0 and pan_y != 0.0) {
        if (pan_x > 1.0)  { pan_x = 1.0; }
        if (pan_x < -1.0) { pan_x = -1.0; }
        if (pan_y > 1.0)  { pan_y = 1.0; }
        if (pan_y < -1.0) { pan_y = -1.0; }

        pan_x = pan_x * 0.7071;
        pan_y = pan_y * 0.7071;
    }

    if (pan_x != 0.0 or pan_y != 0.0) {
        Camera_PanScreenSpace(pan_x * PAN_SPEED * dt, pan_y * PAN_SPEED * dt);
    }

    var mouseWorld = Input_GetMouseWorldPos();
    var hovered = Math_WorldToHex(mouseWorld.x, mouseWorld.y);
    SetSelectedHex(hovered.q, hovered.r);
}