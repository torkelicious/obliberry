var player = PropEntity("player");
var can_id = Prop("can_id", "can1");
var pickup_sfx = Prop("pickup_sound", "assets/audio/item_pickup.mp3");
var key = ";" + can_id + ";";
var checked = false;

fn already_taken() {
    var taken = save_get("cans");
    if (taken == null) { return false; }
    return contains(taken, key);
}

fn on_update(dt) {
    if (checked) { return; }
    checked = true;
    if (already_taken()) { this.Destroy(); }
}

fn on_trigger_enter(other) {
    if (other == null or player == null) { return; }
    if (other != player) { return; }
    if (save_get("quest") != "active") { return; }
    if (already_taken()) { return; }

    var fuel = save_get("fuel");
    if (fuel == null) { fuel = 0; }
    save_set("fuel", fuel + 1);

    var taken = save_get("cans");
    if (taken == null) { taken = ""; }
    save_set("cans", taken + key);

    Broadcast("serialize", null);

    if (pickup_sfx != "") { PlaySound2D(pickup_sfx, 0.8); }
    this.Destroy();
}
