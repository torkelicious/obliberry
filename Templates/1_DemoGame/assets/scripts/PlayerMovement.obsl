// PlayerMovement

var can_move = true;

fn on_message(name, val) { if (name == "toggle_move") { can_move = val; } }

fn move() {

    if (!can_move) {
        ClearPathTarget();
        ClearSelectionOverlay();
        return;
    }

    var movement = this.GetComponent("Movement");

    var mouseWorld = Input_GetMouseWorldPos();
    var hovered = Math_WorldToHex(mouseWorld.x, mouseWorld.y);
    SetSelectedHex(hovered.q, hovered.r);

    if (Input_IsMousePressed(0)) {
        var selection = GetSelectedHex();
        if (selection.hasSelection) { SetPathToHex(this.id, selection.q, selection.r, true); }
    }

    if (movement != null) { if (movement.GetIsMoving() == false) { ClearPathTarget(); } }
}

fn camera_follow() {
    var tf = this.GetComponent("Transform");
    if (tf == null) { return; }
    var pos = tf.GetPosition();
    Camera_SetPosition(pos[0], pos[1], pos[2]);
    Camera_SetZoom(1.5);
}

fn on_update(dt) {
    move();
    camera_follow();
}
