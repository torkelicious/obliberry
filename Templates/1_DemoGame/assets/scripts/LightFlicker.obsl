var who = PropEntity("who");  // who as in who is allowed to enter door
var target = Prop("target_scene", "assets/scenes/junkyard.json");
var sfx = Prop("door_sound", "assets/audio/door_metal.mp3");

fn on_trigger_enter(other) {
    if (other == null or who == null) { return; }
    if (other == who) {
        if (sfx != "") { PlaySound2D(sfx, 0.8, true); }
        save_set("used_door", true);
        LoadScene(target);
    }
}

if (Input_IsMousePressed(0)) {
    var selection = GetSelectedHex();
    if (selection.hasSelection) { SetPathToHex(this.id, selection.q, selection.r, true); }
}

if (movement != null) { if (movement.GetIsMoving() == false) { ClearPathTarget(); } }

fn camera_follow() {
    var tf = this.GetComponent("Transform");
    if (tf == null) { return; }
    var pos = tf.GetPosition();
    Camera_SetPosition(pos[0], pos[1], pos[2]);
    Camera_SetZoom(1.5);
}

fn on_update(dt) {
    move();
    camera_follow();
}
