var base = Prop("base_intensity", 1.0);
var amount = Prop("flicker", 0.12);
var speed = Prop("speed", 9.0);
var t = 0;

fn on_update(dt) {
    var l = this.GetComponent("PointLight");
    if (l == null) { return; }
    t += dt;

    l.SetIntensity(base + sin(t * speed) * amount + (random() - 0.5) * amount * 0.5);
}
