var DESIGN_W = 1280;
var DESIGN_H = 720;

fn center_x(w) { return (DESIGN_W - w) / 2; }
fn center_y(h) { return (DESIGN_H - h) / 2; }

fn fmt_time(t) {
    if (t == null) { return "--"; }
    return to_string(round(t * 10) / 10) + "s";
}

fn fill(text, n) { return replace(text, "{n}", to_string(n)); }

fn latest_save() {
    var saves = save_list();
    if (saves.len == 0) { return null; }
    return saves[0];
}

fn delete_all_saves() {
    var saves = save_list();
    foreach (var s in saves) { save_delete(s.filename); }
}

fn make_panel(name, x, y, w, h, parent) {
    var p = CreateUIRect(name);
    p.SetPosition(x, y);
    p.SetSize(w, h);
    p.SetColor(0.12, 0.12, 0.14, 0.92);
    if (parent != null) { p.SetParent(parent); }
    return p;
}

fn make_label(name, x, y, w, h, parent) {
    var t = CreateUIText(name);
    t.SetPosition(x, y);
    t.SetSize(w, h);
    t.SetFont("OpenSans-Regular");
    t.SetColor(1.0, 1.0, 1.0, 1.0);
    if (parent != null) { t.SetParent(parent); }
    return t;
}

fn make_button(name, label, x, y, w, h, parent) {
    var b = CreateUIButton(name);
    b.SetPosition(x, y);
    b.SetSize(w, h);
    b.SetText(label);
    b.SetFont("OpenSans-Regular");
    b.SetTextColor(1.0, 1.0, 1.0, 1.0);
    b.SetBackgroundColor(0.25, 0.25, 0.25, 1.0);
    if (parent != null) { b.SetParent(parent); }
    return b;
}
