// Types, arithmetic, and strings
var num = (10 + 2 * 3) - (8 % 6);
var str = "ObSL";
println "Hello " + str + "! Result: " + num; // Expected: Hello ObSL! Result: 14

// Prefix / Postfix
var c = 0;
println c++; // Expected: 0
println ++c; // Expected: 2

// Arrays & Foreach
var arr = [10, 20, 30];
arr[1] = 99;
foreach (var item in arr) {
    println item; // Expected: 10, 99, 30
}

// Scoping
var scope = "global";
{
    var scope = "local";
}
println scope; // Expected: global

// Control Flow (If, For, Switch)
if (num == 14) println "If works";

for (var i = 0; i < 3; i++) {
    if (i == 1) break;
    println i; // Expected: 0
}

switch ("match") {
    case "match":
        println "Switch works";
    default:
        println "Miss";
}

// Functions, Recursion, & Closures
fn factorial(n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}
println factorial(5); // Expected: 120

fn make_counter() {
    var count = 0;
    fn increment() { return ++count; }
    return increment;
}
var counter = make_counter();
println counter(); // Expected: 1

// Native Objects, Nested Structures, & Properties
var obj = Object();
obj.name = "Alice";

var matrix = [[Object()]];
matrix[0][0].id = 777;

println obj.name;        // Expected: Alice
println matrix[0][0].id; // Expected: 777
println "string".len;    // Expected: 6

// Logical Short-Circuiting
var effect_run = false;
fn effect() {
    effect_run = true;
    return true;
}
var check = (false and effect()) or (true or effect());
println effect_run; // Expected: false

// Benchmark
var start = clock();
var loops = 0;
while (loops < 10000) loops++;
println clock() - start;