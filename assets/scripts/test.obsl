var timer = clock();
println "obsl testing...";

// modules
using "assets/scripts/module_test.obsl";

// Variables and Math
var a = 10;
var b = 20.5;
a += 5;
a++;
b--;

assert(a == 16, "Math assignment test failed");
assert(b == 19.5, "Math decrement test failed");
println "Variables & Math OK";

// Bitwise Operations
var bitAnd = 5 & 3;
var bitOr = 5 | 3;
var bitXor = 5 ^ 3;
var bitNot = ~0;
var bitLShift = 2 << 3;
var bitRShift = 16 >> 2;

assert(bitAnd == 1, "Bitwise AND test failed");
assert(bitOr == 7, "Bitwise OR test failed");
assert(bitXor == 6, "Bitwise XOR test failed");
assert(bitNot == -1, "Bitwise NOT test failed");
assert(bitLShift == 16, "Bitwise Left Shift test failed");
assert(bitRShift == 4, "Bitwise Right Shift test failed");
println "Bitwise Operations OK";

// Control Flow
var flowTest = false;
if (a > 10) {
    flowTest = true;
} else {
    flowTest = false;
}
assert(flowTest == true, "if/else test failed");

var switchResult = 0;
switch (2) {
    case 1: switchResult = 1;
    case 2: switchResult = 2;
    case 3: switchResult = 3;
}
assert(switchResult == 2, "switch test failed");
println "Control Flow OK";

// Loops & Arrays
var whileCount = 0;
while (whileCount < 3) {
    whileCount++;
}
assert(whileCount == 3, "While loop failed");

var forSum = 0;
for (var i = 1; i <= 4; i++) {
    forSum += i;
}
assert(forSum == 10, "For loop failed");

var arr = [10, 20, 30];
assert(arr.len == 3, "Array length failed");

arr[1] = 99;
assert(arr[1] == 99, "Array index assignment failed");
arr[1] = 20;

var foreachSum = 0;
foreach (var num in arr) {
    foreachSum += num;
}
assert(foreachSum == 60, "Foreach loop failed");
println "Loops & Arrays: OK";

// Functions & Closures
fn createAdder(baseAmount) {
    fn adder(value) {
        return value + baseAmount;
    }
    return adder;
}
var addFive = createAdder(5);
assert(addFive(10) == 15, "closure test failed");
println "Functions & Closures OK";

// Objects
var obj = Object();
obj.val = 42;

fn getVal() {
    return 42;
}
obj.method = getVal;

assert(obj.val == 42, "Object property failed");
assert(obj.method() == 42, "Object method failed");
println "Objects OK";

// StdLib Conversion
assert(to_string(12.5) == "12.500000", "to_string failed");
assert(to_num("12.5") == 12.5, "to_num failed");
println "StdLib Conversion OK";

// StdLib Math
assert(sqrt(25.0) == 5.0, "sqrt failed");
assert(pow(2.0, 4.0) == 16.0, "pow failed");
assert(min(5.0, 10.0) == 5.0, "min failed");
assert(max(5.0, 10.0) == 10.0, "max failed");
assert(clamp(15.0, 0.0, 10.0) == 10.0, "clamp failed");
assert(round(4.6) == 5.0, "round failed");
assert(abs(-42.0) == 42.0, "abs failed");
println "StdLib Math OK";

// StdLib String
assert(len("ObSL") == 4.0, "len failed");
assert(to_lower("TEST") == "test", "to_lower failed");
assert(to_upper("test") == "TEST", "to_upper failed");
assert(starts_with("hello world", "hello") == true, "starts_with failed");
assert(contains("hello world", "world") == true, "contains failed");
assert(substring("hello", 0.0, 4.0) == "hell", "substring failed");
assert(trim("   hi  ") == "hi", "trim failed");
assert(replace("a b a", "a", "c") == "c b c", "replace failed");
println "StdLib String OK";


// more func tests
fn functionWithDefaults(param = 100) {
    return param;
}
assert(functionWithDefaults() == 100, "Function default parameter failed");

// math edge cases
assert(min(-5.0, -10.0) == -10.0, "Negative min failed");
assert(clamp(-5.0, 0.0, 10.0) == 0.0, "Clamp lower bound failed");
assert(round(4.5) == 5.0, "Round midpoint failed");

assert(true or false, "Logical OR failed");
assert(!(false and true), "Logical AND / NOT failed");
println "StdLib Advanced & Edge Cases OK";

// StdLib System
var tStart = clock();
//var testFile = "obsl_io_test.txt";

//wait(0.05);
//var tEnd = clock();
//assert(tEnd > tStart, "clock/wait failed");
println "StdLib System OK";

// StdLib Reflection
assert(type_of(a) == "number", "type_of failed for number");
assert(type_of("hello") == "string", "type_of failed for string");
assert(type_of(flowTest) == "bool", "type_of failed for boolean");
assert(type_of(arr) == "array", "type_of failed for array");
assert(type_of(obj) == "object", "type_of failed for object");
assert(type_of(createAdder) == "callable", "type_of failed for script function");
assert(type_of(sqrt) == "callable", "type_of failed for native function");

assert(get_arity(createAdder) == 1, "get_arity failed for free function");
assert(get_arity(addFive) == 1, "get_arity failed for closure function");
assert(get_arity(sqrt) == 1, "get_arity failed for native function with 1 argument");
assert(get_arity(clamp) == 3, "get_arity failed for native function with 3 arguments");

assert(has_field(obj, "val") == true, "has_field failed to find existing property");
assert(has_field(obj, "method") == true, "has_field failed to find existing method");
assert(has_field(obj, "nonexistent") == false, "has_field falsely confirmed a missing field");

var fields = get_fields(obj);
assert(fields.len == 2, "get_fields array length mismatch");
println "StdLib Reflection OK";

// error handling
try {
    println "Attempting invalid math";
    var bad = "hello";
    var root = sqrt(bad);
    println "This line will never print!";
} catch (err) {
    println "Caught an error successfully";
    assert(type_of(err) == "string", "Error catch variable is not a string description");
}

println "Error Handling OK";

println "";
println "All core and stdlib tests completed successfully";
println "";

//println "testing deliberate uncaught throw";
//throw("this is a runtime error...");
//println "double check";
// works

println"";
var a = 1;var b = a; var c = b;var d = c;
println d;

// mem leak

// Create two arrays on the heap (ref count = 1 each)
var parent = [1,2];
var child = [3,4];
// Make them point to each other (ref count = 2 each)
parent[0] = child;
child[0] = parent;
// When the script finishes, 'parent' and 'child' variables are destroyed.
// The ref counts drop to 1.... never deletes them. Memory leak...


println"";
println "execution timer:" + (clock() - timer);
