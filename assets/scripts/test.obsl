// DATA TYPES & OPERATORS
var num = 42;
var str = "ObSL";
var boolean = true;
var empty = null;

println num;     // Expected: 42
println str;     // Expected: ObSL
println boolean; // Expected: true
println empty;   // Expected: null

println (10 + 2 * 3) - (8 % 6); // Expected: 14
println "Welcome to " + str + "!";

// Prefix vs Postfix
var counter = 10;
println counter++; // Expected: 10
println counter;   // Expected: 11
println ++counter; // Expected: 12

// ARRAYS & NEW FOREACH
var my_arr = [10, 20, 30];
println my_arr[1]; // Expected: 20

my_arr[1] = 99;
println my_arr[1]; // Expected: 99

println "Testing foreach loop:";
foreach (var item in my_arr) {
    println item;
}

// SCOPING & SHADOWING
var scope_test = "global";
{
    var inner_assign = "local";
    var scope_test = "shadowed";
    println inner_assign; // Expected: local
    println scope_test;   // Expected: shadowed
}
println scope_test;       // Expected: global

// CONTROL FLOW
var x = 5;
if (x > 10) {
    println "Error";
} else {
    println "Success: If/Else works";
}

var countdown = 3;
while (countdown > 0) {
    println countdown;
    countdown--;
}

for (var i = 0; i < 10; i++) {
    if (i == 4) {
        println "Breaking early at 4";
        break;
    }
    println i;
}

// SWITCH
var s = "4";
switch (s) {
    case "4":
        println "Switch Expected";
    default:
        println "Unknown";
}

// FUNCTIONS & RECURSION
fn add(a, b) {
    return a + b;
}
println add(7, 8); // Expected: 15

fn factorial(n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}
println factorial(5); // Expected: 120

// LEXICAL CLOSURES
fn generate_counter() {
    var count = 0;
    fn incrementer() {
        count++;
        return count;
    }
    return incrementer;
}
var ticket_system = generate_counter();
println ticket_system(); // Expected: 1
println ticket_system(); // Expected: 2

// STRING LITERALS & PROPERTIES
print "No newline...";
print ' single quote test\n';

var strtestlen = "12345678";
print "Length (Expected 8): ";
println strtestlen.len;

// BENCHMARK
var start_time = clock();
var bench_counter = 0;
for (var i = 0; i < 10000; i++) {
    bench_counter++;
}
var end_time = clock();
print "Benchmark elapsed: ";
println end_time - start_time;