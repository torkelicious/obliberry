var start_time = clock();
var suites_passed = 0;

fn pass_suite(name) {
    println "[ OK ] " + name;
    suites_passed++;
}

try {
    using "assets/scripts/module_test.obsl";
    pass_suite("Module Import System");
} catch (err) {}

var a = 10;
var b = 20.5;
a += 5;
a++;
b--;
assert(a == 16, "Math assignment test failed");
assert(b == 19.5, "Math decrement test failed");
pass_suite("Variables & Math Operations");

var bitAnd = 5 & 3;
var bitOr = 5 | 3;
var bitXor = 5 ^ 3;
var bitNot = ~0;
var bitLShift = 2 << 3;
var bitRShift = 16 >> 2;
assert(bitAnd == 1, "Bitwise AND test failed");
assert(bitOr == 7, "Bitwise OR test failed");
assert(bitXor == 6, "Bitwise XOR test failed");
assert(bitNot == -1, "Bitwise NOT test failed");
assert(bitLShift == 16, "Bitwise Left Shift test failed");
assert(bitRShift == 4, "Bitwise Right Shift test failed");
pass_suite("Bitwise Operations");

var flowTest = false;
if (a > 10) {
    flowTest = true;
} else {
    flowTest = false;
}
assert(flowTest == true, "if/else test failed");

var switchResult = 0;
switch (2) {
    case 1: switchResult = 1;
    case 2: switchResult = 2;
    case 3: switchResult = 3;
}
assert(switchResult == 2, "switch test failed");
pass_suite("Control Flow (If/Switch)");

var whileCount = 0;
while (whileCount < 3) {
    whileCount++;
}
assert(whileCount == 3, "While loop failed");

var forSum = 0;
for (var i = 1; i <= 4; i++) {
    forSum += i;
}
assert(forSum == 10, "For loop failed");
pass_suite("Iterators (While/For)");

var arr = [10, 20, 30];
assert(arr.len == 3, "Array length failed");

var foreachSum = 0;
foreach (var num in arr) {
    foreachSum += num;
}
assert(foreachSum == 60, "Foreach loop failed");

arr[0] = 15;
arr[-1] = 99;
arr[-2] = 55;
assert(arr[0] == 15, "Array state corrupted at index 0");
assert(arr[1] == 55, "Negative index assignment (-2) failed");
assert(arr[2] == 99, "Negative index assignment (-1) failed");

var dynamic_arr = [];
dynamic_arr.push(100);
dynamic_arr.push(200);
dynamic_arr[-1] = 250;
var popped = dynamic_arr.pop();
assert(popped == 250, "Incorrect element returned from pop()");
assert(dynamic_arr.len == 1, "Array length mismatch after pop()");

dynamic_arr.clear();
assert(dynamic_arr.len == 0, "Array length mismatch after clear()");
pass_suite("Arrays & Collection Methods");

fn createAdder(baseAmount) {
    fn adder(value) { return value + baseAmount; }
    return adder;
}
var addFive = createAdder(5);
assert(addFive(10) == 15, "Closure behavior test failed");

fn functionWithDefaults(param = 100) { return param; }
assert(functionWithDefaults() == 100, "Function default parameter evaluation failed");
pass_suite("Functions & Closures");

var obj = Object();
obj.val = 42;
fn getVal() { return 42; }
obj.method = getVal;
assert(obj.val == 42, "Object property lookup failed");
assert(obj.method() == 42, "Object method execution failed");
pass_suite("Dynamic Objects");

struct Vector3 { x; y; z; }
var vec = Vector3(10, 20, 30);
assert(vec.x == 10, "Struct field evaluation X failed");
vec.x = 150;
assert(vec.x == 150, "Struct mutation field X failed");

var partialVec = Vector3(5);
assert(partialVec.x == 5, "Struct initialization with partial arguments failed");

fn modifyStruct(v) { v.z = 999; }
modifyStruct(vec);
assert(vec.z == 999, "Struct pass-by-reference mutation failed");
pass_suite("Struct Instantiation & References");

assert(regex_match("12345", "^\\d+$") == true, "regex_match exact true failed");
assert(regex_match("123a45", "^\\d+$") == false, "regex_match exact false failed");
assert(regex_search("error code: 404", "\\d+") == true, "regex_search pattern find failed");
assert(regex_search("hello world", "\\d+") == false, "regex_search pattern negative failed");
var clean = regex_replace("price is 100 dollars", "\\d+", "99");
assert(clean == "price is 99 dollars", "regex_replace digits failed");
var matches = regex_find_all("apples, oranges, bananas", "[a-zA-Z]+");
assert(matches.len == 3.0, "regex_find_all length failed");
assert(matches[0] == "apples", "regex_find_all index 0 failed");
assert(matches[1] == "oranges", "regex_find_all index 1 failed");
assert(matches[2] == "bananas", "regex_find_all index 2 failed");

try {
    regex_match("test", "([a-z]");
    assert(false, "Failed to trap invalid regex syntax error");
} catch (err) {}
pass_suite("Standard Library (Regex Validation)");

assert(to_string(12.5) == "12.5", "to_string basic conversion failed");
assert(to_string(13.0) == "13", "to_string whole number failed");
assert(to_string(0.003) == "0.003", "to_string small fraction failed");
assert(to_string(-42.1234) == "-42.1234", "to_string negative fraction failed");
assert(to_string(0.0) == "0", "to_string zero failed");

assert(to_fixed(3.14159, 2) == "3.14", "to_fixed standard rounding failed");
assert(to_fixed(3.14159, 0) == "3", "to_fixed zero decimal places failed");
assert(to_fixed(13.0, 2) == "13.00", "to_fixed padding whole numbers failed");
assert(to_fixed(13.1, 4) == "13.1000", "to_fixed padding fractions failed");
assert(to_fixed(0.0, 3) == "0.000", "to_fixed zero padding failed");
assert(to_fixed(-1.239, 2) == "-1.24", "to_fixed negative rounding failed");

assert(to_num("12.5") == 12.5, "to_num conversion failed");
assert(sqrt(25.0) == 5.0, "Math sqrt failed");
assert(pow(2.0, 4.0) == 16.0, "Math pow failed");
assert(clamp(-5.0, 0.0, 10.0) == 0.0, "Math clamp lower bound failed");
assert(abs(-42.0) == 42.0, "Math abs failed");
assert(len("ObSL") == 4.0, "String len failed");
assert(to_upper("test") == "TEST", "String to_upper failed");
assert(substring("hello", 0.0, 4.0) == "hell", "String substring failed");
assert(replace("a b a", "a", "c") == "c b c", "String replace failed");
pass_suite("Standard Library (Math/Strings & Formatting)");

assert(type_of(a) == "number", "Reflection type_of number failed");
assert(type_of(arr) == "array", "Reflection type_of array failed");
assert(type_of(vec) == "object", "Reflection type_of struct instance failed");
assert(type_of(createAdder) == "callable", "Reflection type_of script function failed");
assert(get_arity(clamp) == 3, "Reflection get_arity 3-arg native function failed");
assert(has_field(obj, "val") == true, "Reflection has_field dynamic property failed");

var fields = get_fields(obj);
assert(fields.len == 2, "Reflection get_fields element count mismatch");
pass_suite("Standard Library (Reflection)");

try {
    var root = sqrt("bad_type");
    assert(false, "Error execution flow failed to trap exception");
} catch (err) {
    assert(type_of(err) == "string", "Caught exception object is not a string description");
}
pass_suite("Error Handling (Try/Catch)");

var value = 10;
assert(value is number, "is number failed");
value = "test";
assert(value is string, "is string failed");
value = null;
assert(value is null, "is null failed");
value = true;
assert(value is bool,"is bool failed");
pass_suite("Type checking via 'is' operator");

var parent_arr = [1, 2];
var child_arr = [3, 4];
parent_arr[0] = child_arr;
child_arr[0] = parent_arr;

var parent_obj = Object();
var child_obj = Object();
parent_obj.child = child_obj;
child_obj.parent = parent_obj;

var idx = 0;
while (idx < 2000) {
    var temp_arr = [idx, idx + 1, idx + 2];
    var temp_obj = Object();
    temp_obj.data = temp_arr;
    idx++;
}
pass_suite("GC Threshold & Cyclic Tracking");




var elapsed = clock() - start_time;
println "SUCCESS: " + to_string(suites_passed) + " suites passed in " + to_fixed(elapsed, 3) + " seconds.";

