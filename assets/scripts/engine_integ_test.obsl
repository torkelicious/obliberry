var timer = 0.0;

println "engine integration test loaded";

// this is called on Scene.Update(); ! :DDD
fn on_update(entity_id, dt) {
    timer += dt;
    if (timer >= 2.0) {
        print "[ Engine ObSL Integration Test ] ";
        print_name(entity_id);
        timer = 0.0;
    }
}

fn on_destroy(entity_id){
println("Entity destroyed:");
print_name(entity_id);
}


fn on_exit(entity_id){
    println("script: scene exiting");
}